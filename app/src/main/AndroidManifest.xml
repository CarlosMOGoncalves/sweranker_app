<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="pt.cmg.sweranker">

    <application
        android:name=".SweRankerApplication"
        android:allowBackup="true"
        android:icon="@drawable/swe_ranker_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/swe_ranker_logo_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".swebok.SwebokLoaderService"
            android:exported="false" />
        <service
            android:name=".degrees.DegreesLoaderService"
            android:exported="false" />
        <service
            android:name=".ranking.RankingService"
            android:exported="false" />
    </application>

</manifest>