<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="pt.cmg.sweranker">

    <application
        android:allowBackup="true"
        android:icon="@drawable/swe_ranker_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/swe_ranker_logo_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".DegreeClassActivity"
            android:label="@string/title_activity_degree_class"
            android:theme="@style/AppTheme" />

        <service
            android:name=".swebok.SwebokLoaderService"
            android:exported="false" />
        <service
            android:name=".degrees.DegreesLoaderService"
            android:exported="false" />
        <service
            android:name=".degrees.DegreeMatcherService"
            android:exported="false"></service>
    </application>

</manifest>