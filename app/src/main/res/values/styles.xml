<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:textColor">@color/textColor</item>
        <item name="android:textColorPrimary">@color/textColor</item>
        <!--item name="android:navigationBarColor">@color/cardColour6</item-->
        <!--item name="android:colorControlNormal">@color/cardColour6</item-->
        <!--item name="android:colorControlActivated">?attr/colorControlActivated</item-->
        <!--item name="android:colorControlHighlight">@color/colorPrimary</item-->
        <!--item name="android:colorButtonNormal">?attr/colorButtonNormal</item-->
    </style>


    <style name="ToolbarTheme">
        <!-- android:textColorPrimary is the color of the title text in the Toolbar  -->
        <item name="android:textColorPrimary">@color/white</item>
        <!-- actionMenuTextColor is the color of the text of action (menu) items  -->
        <item name="actionMenuTextColor">@android:color/holo_green_light</item>
        <!-- Tints the input fields like checkboxes and text fields -->
        <!--item name="colorAccent">@color/test_color</item-->
        <!-- Colour of the menu button-->
        <item name="colorControlNormal">@color/white</item>
    </style>


    <style name="TabLayoutTheme" parent="Widget.Design.TabLayout">
        <item name="tabIndicatorColor">@android:color/holo_green_light</item>
        <item name="tabIndicatorHeight">5dp</item>
        <item name="tabBackground">@color/colorPrimaryDark</item>
        <item name="tabTextAppearance">@style/TextAppearance.Design.Tab</item>
        <item name="tabSelectedTextColor">@color/white</item>
        <!-- This acts basically as the color of the unselected tab -->
        <item name="tabTextColor">@color/unselectedTextColor</item>
    </style>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

</resources>
