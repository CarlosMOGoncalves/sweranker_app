<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <declare-styleable name="MaterialSpinner" tools:ignore="ResourceName">
        <attr name="materialspinner_arrow_tint" format="color" />
        <attr name="materialspinner_hide_arrow" format="boolean" />
        <attr name="materialspinner_dialog_mode" format="boolean" />
        <attr name="materialspinner_background_color" format="color" />
        <attr name="materialspinner_text_color" format="color" />
        <attr name="materialspinner_dropdown_max_height" format="dimension" />
        <attr name="materialspinner_dropdown_height" format="dimension">
            <enum name="fill_parent" value="-1" />
            <enum name="match_parent" value="-1" />
            <enum name="wrap_content" value="-2" />
        </attr>
    </declare-styleable>
</resources>