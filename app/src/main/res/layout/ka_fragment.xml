<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/ka_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ka_details_image"
            android:layout_width="@dimen/ka_image_height"
            android:layout_height="@dimen/ka_image_height"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/function" />

        <TextView
            android:id="@+id/ka_details_name"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Software Cenas"
            android:textAlignment="center"
            android:textColor="@color/colorPrimaryDark"
            android:textSize="@dimen/ka_detail_title_size" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ka_info"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_below="@+id/ka_header">

        <TextView
            android:id="@+id/description_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/description"
            android:textColor="@color/colorPrimaryDark"
            android:textSize="@dimen/ka_detail_subtitle_size" />

        <TextView
            android:id="@+id/ka_details_description_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DescriptionText"
            android:textColor="@android:color/black" />

        <TextView
            android:id="@+id/ka_details_topics_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Topics"
            android:textColor="@color/colorPrimaryDark"
            android:textSize="@dimen/ka_detail_subtitle_size" />

        <android.support.v7.widget.RecyclerView
            android:id="@+id/ka_details_topics_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </LinearLayout>


</RelativeLayout>