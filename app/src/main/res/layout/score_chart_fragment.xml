<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:fillViewport="true">

    <android.support.constraint.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:context="pt.cmg.sweranker.ranking.ScoreChartFragment">

        <TextView
            android:id="@+id/degree_overview_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="0dp"
            android:layout_marginEnd="8dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:text="Degree Overview"
            android:textAlignment="center"
            android:textSize="@dimen/ranking_name_text_size"
            app:layout_constraintBottom_toTopOf="@+id/coverage_area"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/overview_button"
            android:layout_width="@dimen/ranking_name_text_size"
            android:layout_height="@dimen/ranking_name_text_size"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:background="@color/cardview_light_background"
            android:scaleType="centerCrop"
            android:src="@drawable/interrogation"
            android:tint="@color/cardColour2"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintStart_toEndOf="@+id/degree_overview_label"
            app:layout_constraintBottom_toTopOf="@+id/coverage_area"
            app:layout_constraintTop_toTopOf="parent" />

        <android.support.v7.widget.CardView
            android:id="@+id/coverage_area"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:layout_marginStart="5dp"
            android:layout_marginTop="8dp"
            app:contentPadding="@dimen/card_inner_padding"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/chart_legend"
            app:layout_constraintTop_toBottomOf="@+id/degree_overview_label">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/coverage_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/border_below"
                    android:paddingBottom="5dp"
                    android:text="@string/coverage_chart_label"
                    android:textAlignment="center"
                    android:textSize="@dimen/ranking_name_text_size"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/degree_overview_label" />

                <com.github.mikephil.charting.charts.RadarChart
                    android:id="@+id/coverage_chart"
                    android:layout_width="match_parent"
                    android:layout_height="400dp"
                    android:background="@color/hollow"
                    android:paddingTop="5dp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/coverage_chart_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminate="true" />
        </android.support.v7.widget.CardView>

        <android.support.v7.widget.CardView
            android:id="@+id/chart_legend"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:layout_marginStart="5dp"
            android:layout_marginTop="8dp"
            app:contentPadding="@dimen/card_inner_padding"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/percentile_chart_area"
            app:layout_constraintTop_toBottomOf="@+id/coverage_area">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/legend_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/border_below"
                    android:paddingBottom="5dp"
                    android:text="@string/chart_subtitle"
                    android:textAlignment="center"
                    android:textSize="@dimen/ranking_name_text_size"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/degree_overview_label" />

                <GridLayout
                    android:id="@+id/chart_legend_table"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingBottom="5dp"
                    android:paddingEnd="5dp"
                    android:paddingStart="5dp"
                    android:paddingTop="5dp">

                </GridLayout>
            </LinearLayout>

        </android.support.v7.widget.CardView>

        <android.support.v7.widget.CardView
            android:id="@+id/percentile_chart_area"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:layout_marginStart="5dp"
            android:layout_marginTop="8dp"
            app:contentPadding="@dimen/card_inner_padding"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/top_ka_chart_area"
            app:layout_constraintTop_toBottomOf="@+id/chart_legend">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/ka_percentile_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/border_below"
                    android:paddingBottom="5dp"
                    android:text="@string/ka_distribution"
                    android:textAlignment="center"
                    android:textSize="@dimen/ranking_name_text_size"
                    app:layout_constraintTop_toBottomOf="@+id/chart_legend" />

                <com.github.mikephil.charting.charts.PieChart
                    android:id="@+id/ka_distribution_chart"
                    android:layout_width="match_parent"
                    android:layout_height="400dp"
                    android:background="@color/hollow"
                    android:paddingTop="5dp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/percent_chart_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminate="true" />
        </android.support.v7.widget.CardView>

        <android.support.v7.widget.CardView
            android:id="@+id/top_ka_chart_area"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:layout_marginStart="5dp"
            android:layout_marginTop="8dp"
            app:contentPadding="@dimen/card_inner_padding"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/top_ka_topics_chart_area"
            app:layout_constraintTop_toBottomOf="@+id/percentile_chart_area">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">


                <TextView
                    android:id="@+id/top_ka_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/border_below"
                    android:paddingBottom="5dp"
                    android:text="@string/top_kas"
                    android:textAlignment="center"
                    android:textSize="@dimen/ranking_name_text_size"
                    app:layout_constraintTop_toBottomOf="@+id/percentile_chart_area" />


                <com.github.mikephil.charting.charts.HorizontalBarChart
                    android:id="@+id/top_kas_chart"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:layout_gravity="center"
                    android:background="@color/hollow"
                    android:paddingTop="5dp">

                </com.github.mikephil.charting.charts.HorizontalBarChart>


            </LinearLayout>

            <ProgressBar
                android:id="@+id/top_kas_chart_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminate="true" />

        </android.support.v7.widget.CardView>

        <android.support.v7.widget.CardView
            android:id="@+id/top_ka_topics_chart_area"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:layout_marginEnd="5dp"
            android:layout_marginStart="5dp"
            android:layout_marginTop="8dp"
            app:contentPadding="@dimen/card_inner_padding"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/top_ka_chart_area">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/top_ka_topics_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/border_below"
                    android:paddingBottom="5dp"
                    android:text="@string/top_ka_topics"
                    android:textAlignment="center"
                    android:textSize="@dimen/ranking_name_text_size" />


                <com.github.mikephil.charting.charts.HorizontalBarChart
                    android:id="@+id/top_ka_topics_chart"
                    android:layout_width="match_parent"
                    android:layout_height="500dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="5dp"
                    android:background="@color/hollow">

                </com.github.mikephil.charting.charts.HorizontalBarChart>
            </LinearLayout>

            <ProgressBar
                android:id="@+id/top_ka_topics_chart_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminate="true" />
        </android.support.v7.widget.CardView>

    </android.support.constraint.ConstraintLayout>
</ScrollView>