<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/degree_matcher_spinner_topic_line_height"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/topic_name"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_weight="6"
        android:gravity="center_vertical"
        android:text="Program Topic: Functions" />

    <ImageButton
        android:id="@+id/info_button"
        android:layout_width="@dimen/degree_matcher_spinner_item_interrogation_image_size"
        android:layout_height="@dimen/degree_matcher_spinner_item_interrogation_image_size"
        android:background="@color/hollow"
        android:scaleType="fitXY"
        android:layout_gravity="center"
        app:srcCompat="@drawable/interrogation" />

</LinearLayout>