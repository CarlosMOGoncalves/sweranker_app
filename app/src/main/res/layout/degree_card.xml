<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <android.support.v7.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardElevation="3dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/university_image"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ka_image_height"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/degree_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/university_image"
                android:paddingLeft="@dimen/ka_title_padding"
                android:paddingRight="@dimen/ka_title_padding"
                android:text="MEI"
                android:textAlignment="center"
                android:textColor="@color/colorPrimaryDark" />

            <TextView
                android:id="@+id/university_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/degree_name"
                android:paddingLeft="@dimen/ka_title_padding"
                android:paddingRight="@dimen/ka_title_padding"
                android:paddingBottom="@dimen/ka_title_padding"
                android:text="UMinho"
                android:textAlignment="center" />

        </RelativeLayout>
    </android.support.v7.widget.CardView>
</LinearLayout>