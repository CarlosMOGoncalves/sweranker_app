<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <android.support.v7.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="@dimen/card_size"

        app:cardElevation="3dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingTop="@dimen/ka_title_padding"
            android:paddingLeft="@dimen/ka_title_padding"
            android:paddingRight="@dimen/ka_title_padding"
            android:paddingBottom="@dimen/ka_title_padding"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/university_image"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:background="@android:color/background_light"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/feup_logo" />

            <TextView
                android:id="@+id/degree_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/university_image"
                android:text="MEI"
                android:textAlignment="center"
                android:textColor="@color/colorPrimaryDark"
                android:background="@android:color/background_light" />

            <TextView
                android:id="@+id/university_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/degree_name"
                android:text="UMinho"
                android:textAlignment="center"
                android:background="@android:color/background_light" />

        </LinearLayout>
    </android.support.v7.widget.CardView>
</LinearLayout>