<?xml version="1.0" encoding="utf-8"?>
<android.support.v7.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ranking_card_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ranking_logo"
            android:layout_width="@dimen/ranking_image_size"
            android:layout_height="@dimen/ranking_image_size"
            android:layout_weight="1"
            android:padding="@dimen/ranking_image_padding"
            android:scaleType="fitXY"
            app:srcCompat="@drawable/logo_eng_uminho" />

        <TextView
            android:id="@+id/ranking_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="MIEIC - Combo 602000" />
    </LinearLayout>

</android.support.v7.widget.CardView>