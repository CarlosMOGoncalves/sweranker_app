<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ka_info"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/description_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/card_margin"
        android:text="@string/description"
        android:textColor="@color/colorPrimaryDark"
        android:textSize="@dimen/ka_detail_subtitle_size" />

    <TextView
        android:id="@+id/ka_details_description_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/card_margin"
        android:text="DescriptionText"
        android:textColor="@android:color/black"
        android:textSize="@dimen/ka_detail_text_size" />

    <TextView
        android:id="@+id/ka_details_topics_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/card_margin"
        android:text="Topics"
        android:textColor="@color/colorPrimaryDark"
        android:textSize="@dimen/ka_detail_subtitle_size" />

</LinearLayout>