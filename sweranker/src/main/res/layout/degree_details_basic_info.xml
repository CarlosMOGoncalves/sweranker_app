<?xml version="1.0" encoding="utf-8"?><!-- I used a Nested ScrollView here because this View will be used inside a scrollable Coordinator Layout
 which caused this ScrollView not to scroll properly in the Degree Details fragment -->
<android.support.v4.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="5dp">

    <TextView
        android:id="@+id/degree_description"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:text="@string/loren_ipsum_description"
        android:background="@android:color/background_light"
        android:textAlignment="textStart"
        android:textSize="@dimen/degree_detail_degree_description_text_size" />
</android.support.v4.widget.NestedScrollView>
