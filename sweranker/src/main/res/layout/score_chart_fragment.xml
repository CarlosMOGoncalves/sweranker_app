<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:transitionGroup="true"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/no_score_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textAlignment="center"
        android:textSize="17sp"
        android:visibility="gone"
        tools:text="No Scores found to display.\n Please run the Calculation for at leat one Degree.\nGo to Action Bar Menu -> Curricula -> Select Degree -> Calculate Score." />

    <ScrollView
        android:id="@+id/content_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:transitionGroup="true"
        android:visibility="visible">

        <android.support.constraint.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:context="pt.cmg.sweranker.ranking.ScoreDetailedChartFragment">


            <android.support.v7.widget.CardView
                android:id="@+id/degree_overview_area"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:layout_marginStart="5dp"
                android:layout_marginTop="8dp"
                app:cardElevation="1dp"
                app:contentPadding="@dimen/card_inner_padding"
                app:layout_constraintBottom_toTopOf="@+id/coverage_area"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed">

                <android.support.constraint.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">


                    <android.support.v7.widget.CardView
                        android:id="@+id/degree_image_area"
                        android:layout_width="@dimen/chart_degree_overview_image_height"
                        android:layout_height="@dimen/chart_degree_overview_image_height"
                        android:layout_marginBottom="8dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="8dp"
                        app:layout_constraintLeft_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <ImageView
                            android:id="@+id/degree_image"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:src="@drawable/feup_logo" />
                    </android.support.v7.widget.CardView>


                    <TextView
                        android:id="@+id/degree_overview_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:layout_marginEnd="8dp"
                        android:textAlignment="center"
                        android:textSize="@dimen/chart_degree_overview_name_text_size"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/degree_image_area"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="MiEIC" />

                    <TextView
                        android:id="@+id/degree_overview_university"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:layout_marginEnd="8dp"
                        android:textAlignment="center"
                        android:textSize="@dimen/chart_degree_overview_university_text_size"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/degree_image_area"
                        app:layout_constraintTop_toBottomOf="@id/degree_overview_name"
                        tools:text="Universidade do Porto" />

                    <TextView
                        android:id="@+id/degree_overview_combo_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:layout_marginEnd="8dp"
                        android:layout_marginTop="2dp"
                        android:textAlignment="center"
                        android:textSize="@dimen/chart_degree_overview_combo_name"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/degree_image_area"
                        app:layout_constraintTop_toBottomOf="@id/degree_overview_university"
                        tools:text="Combination 620075" />

                    <TextView
                        android:id="@+id/show_licenciate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_marginTop="5dp"
                        android:background="@drawable/rounded_shape"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="8dp"
                        android:text="@string/show_licence_degree_score"
                        android:textColor="@color/colorPrimary"
                        android:textSize="@dimen/chart_degree_overview_button_text_size"
                        android:textStyle="bold"
                        android:visibility="gone"
                        app:layout_constraintEnd_toStartOf="@+id/show_overview"
                        app:layout_constraintTop_toBottomOf="@id/degree_overview_combo_name"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <TextView
                        android:id="@+id/show_overview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_marginTop="5dp"
                        android:background="@drawable/rounded_shape"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="8dp"
                        android:text="@string/show_degree_overview"
                        android:textColor="@color/colorPrimary"
                        android:textSize="@dimen/chart_degree_overview_button_text_size"
                        android:textStyle="bold"
                        android:visibility="visible"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/degree_overview_combo_name" />

                </android.support.constraint.ConstraintLayout>

                <ProgressBar
                    android:id="@+id/overview_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:indeterminate="true" />

            </android.support.v7.widget.CardView>


            <android.support.v7.widget.CardView
                android:id="@+id/coverage_area"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:layout_marginStart="5dp"
                android:layout_marginTop="8dp"
                app:contentPadding="@dimen/card_inner_padding"
                app:layout_constraintBottom_toTopOf="@+id/chart_subtitle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/degree_overview_area">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/coverage_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/border_below"
                        android:gravity="center_horizontal"
                        android:paddingBottom="5dp"
                        android:text="@string/coverage_chart_label"
                        android:textAlignment="center"
                        android:textSize="@dimen/score_title_text_size"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/degree_overview_label" />

                    <com.github.mikephil.charting.charts.RadarChart
                        android:id="@+id/coverage_chart"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/chart_swebok_coverage_chart_height"
                        android:background="@color/hollow"
                        android:paddingTop="5dp" />

                    <TextView
                        android:id="@+id/missing_topics_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="10dp"
                        android:background="@drawable/border_below"
                        android:gravity="center_horizontal"
                        android:text="@string/missing_topics" />

                    <android.support.v7.widget.RecyclerView
                        android:id="@+id/missing_topics_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:itemCount="6"
                        tools:layoutManager="android.support.v7.widget.GridLayoutManager"
                        tools:listitem="@layout/score_chart_missing_topics_list_item"
                        tools:spanCount="2">

                    </android.support.v7.widget.RecyclerView>
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/coverage_chart_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:indeterminate="true" />
            </android.support.v7.widget.CardView>

            <android.support.v7.widget.CardView
                android:id="@+id/chart_subtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:layout_marginStart="5dp"
                android:layout_marginTop="8dp"
                app:contentPadding="@dimen/card_inner_padding"
                app:layout_constraintBottom_toTopOf="@+id/distribution_chart_area"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/coverage_area">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/legend_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/border_below"
                        android:gravity="center_horizontal"
                        android:paddingBottom="5dp"
                        android:text="@string/chart_subtitle"
                        android:textAlignment="center"
                        android:textSize="@dimen/score_title_text_size"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/degree_overview_label" />

                    <GridLayout
                        android:id="@+id/chart_legend_table"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingBottom="5dp"
                        android:paddingEnd="5dp"
                        android:paddingStart="5dp"
                        android:paddingTop="5dp">

                    </GridLayout>
                </LinearLayout>

            </android.support.v7.widget.CardView>

            <android.support.v7.widget.CardView
                android:id="@+id/distribution_chart_area"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:layout_marginStart="5dp"
                android:layout_marginTop="8dp"
                app:contentPadding="@dimen/card_inner_padding"
                app:layout_constraintBottom_toTopOf="@+id/top_ka_chart_area"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/chart_subtitle">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/ka_percentile_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/border_below"
                        android:gravity="center_horizontal"
                        android:paddingBottom="5dp"
                        android:text="@string/ka_distribution"
                        android:textAlignment="center"
                        android:textSize="@dimen/score_title_text_size"
                        app:layout_constraintTop_toBottomOf="@+id/chart_subtitle" />

                    <com.github.mikephil.charting.charts.PieChart
                        android:id="@+id/ka_distribution_chart"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/swebok_distribution_chart_height"
                        android:background="@color/hollow"
                        android:paddingTop="5dp" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/percent_chart_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:indeterminate="true" />
            </android.support.v7.widget.CardView>

            <android.support.v7.widget.CardView
                android:id="@+id/top_ka_chart_area"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:layout_marginStart="5dp"
                android:layout_marginTop="8dp"
                app:contentPadding="@dimen/card_inner_padding"
                app:layout_constraintBottom_toTopOf="@+id/top_ka_topics_chart_area"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/distribution_chart_area">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">


                    <TextView
                        android:id="@+id/top_ka_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/border_below"
                        android:gravity="center_horizontal"
                        android:paddingBottom="5dp"
                        android:text="@string/top_kas"
                        android:textAlignment="center"
                        android:textSize="@dimen/score_title_text_size"
                        app:layout_constraintTop_toBottomOf="@+id/distribution_chart_area" />


                    <com.github.mikephil.charting.charts.HorizontalBarChart
                        android:id="@+id/top_kas_chart"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/top_kas_chart_height"
                        android:layout_gravity="center"
                        android:background="@color/hollow"
                        android:paddingTop="5dp">

                    </com.github.mikephil.charting.charts.HorizontalBarChart>


                </LinearLayout>

                <ProgressBar
                    android:id="@+id/top_kas_chart_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:indeterminate="true" />

            </android.support.v7.widget.CardView>

            <android.support.v7.widget.CardView
                android:id="@+id/top_ka_topics_chart_area"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:layout_marginEnd="5dp"
                android:layout_marginStart="5dp"
                android:layout_marginTop="8dp"
                app:contentPadding="@dimen/card_inner_padding"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/top_ka_chart_area">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="10dp">

                    <TextView
                        android:id="@+id/top_ka_topics_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/border_below"
                        android:gravity="center_horizontal"
                        android:paddingBottom="5dp"
                        android:text="@string/top_ka_topics"
                        android:textAlignment="center"
                        android:textSize="@dimen/score_title_text_size" />


                    <com.github.mikephil.charting.charts.HorizontalBarChart
                        android:id="@+id/top_ka_topics_chart"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/top_ka_topics_chart_height"
                        android:layout_gravity="center"
                        android:layout_marginTop="5dp"
                        android:background="@color/hollow">

                    </com.github.mikephil.charting.charts.HorizontalBarChart>
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/top_ka_topics_chart_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:indeterminate="true" />
            </android.support.v7.widget.CardView>


        </android.support.constraint.ConstraintLayout>
    </ScrollView>

</FrameLayout>