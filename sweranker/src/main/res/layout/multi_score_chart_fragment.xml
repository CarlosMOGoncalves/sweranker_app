<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:transitionGroup="true">

    <android.support.constraint.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:context="pt.cmg.sweranker.ranking.ScoreDetailedChartFragment">


        <android.support.v7.widget.CardView
            android:id="@+id/degree_overview_area"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:layout_marginStart="5dp"
            android:layout_marginTop="8dp"
            app:cardElevation="1dp"
            app:contentPadding="@dimen/card_inner_padding"
            app:layout_constraintBottom_toTopOf="@+id/coverage_area"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed">

            <android.support.constraint.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <android.support.constraint.ConstraintLayout
                    android:id="@+id/overview_area"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/overview_area_2"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/degree_overview_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_marginStart="8dp"
                        android:textAlignment="center"
                        android:textColor="@color/scoreComparisonMaterialBlue500"
                        android:textSize="@dimen/chart_degree_overview_name_text_size"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="MiEIC" />

                    <TextView
                        android:id="@+id/degree_overview_university"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_marginStart="8dp"
                        android:textAlignment="center"
                        android:textSize="@dimen/chart_degree_overview_university_text_size"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/degree_overview_name"
                        tools:text="Universidade do Porto" />

                    <TextView
                        android:id="@+id/degree_overview_combo_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="2dp"
                        android:textAlignment="center"
                        android:textSize="@dimen/chart_degree_overview_combo_name"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/degree_overview_university"
                        tools:text="Combination 620075" />

                    <TextView
                        android:id="@+id/show_overview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="8dp"
                        android:layout_marginEnd="8dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="5dp"
                        android:background="@drawable/rounded_shape2"
                        android:clickable="true"
                        android:padding="8dp"
                        android:text="@string/show_overview"
                        android:textAlignment="center"
                        android:textColor="@color/scoreComparisonMaterialBlue500"
                        android:textSize="@dimen/chart_degree_overview_button_text_size"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/degree_overview_combo_name" />
                </android.support.constraint.ConstraintLayout>

                <android.support.constraint.ConstraintLayout
                    android:id="@+id/overview_area_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/overview_area"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/degree_overview_name_2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_marginStart="8dp"
                        android:textAlignment="center"
                        android:textColor="@color/scoreComparisonMaterialRed500"
                        android:textSize="@dimen/chart_degree_overview_name_text_size"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="MEI" />

                    <TextView
                        android:id="@+id/degree_overview_university_2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_marginStart="8dp"
                        android:textAlignment="center"
                        android:textSize="@dimen/chart_degree_overview_university_text_size"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/degree_overview_name_2"
                        tools:text="Universidade do Minho" />

                    <TextView
                        android:id="@+id/degree_overview_combo_name_2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="2dp"
                        android:textAlignment="center"
                        android:textSize="@dimen/chart_degree_overview_combo_name"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/degree_overview_university_2"
                        tools:text="Combination 220582" />

                    <TextView
                        android:id="@+id/show_overview_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="8dp"
                        android:layout_marginEnd="8dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="5dp"
                        android:background="@drawable/rounded_shape3"
                        android:clickable="true"
                        android:padding="8dp"
                        android:text="@string/show_overview"
                        android:textAlignment="center"
                        android:textColor="@color/scoreComparisonMaterialRed500"
                        android:textSize="@dimen/chart_degree_overview_button_text_size"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/degree_overview_combo_name_2" />
                </android.support.constraint.ConstraintLayout>

            </android.support.constraint.ConstraintLayout>

            <ProgressBar
                android:id="@+id/overview_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminate="true" />

        </android.support.v7.widget.CardView>


        <android.support.v7.widget.CardView
            android:id="@+id/coverage_area"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:layout_marginStart="5dp"
            android:layout_marginTop="8dp"
            app:contentPadding="@dimen/card_inner_padding"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/chart_subtitle"
            app:layout_constraintTop_toBottomOf="@+id/degree_overview_area">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/coverage_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/border_below"
                    android:paddingBottom="5dp"
                    android:text="@string/coverage_chart_label"
                    android:textAlignment="center"
                    android:textSize="@dimen/score_title_text_size"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/degree_overview_label" />

                <com.github.mikephil.charting.charts.RadarChart
                    android:id="@+id/coverage_chart"
                    android:layout_width="match_parent"
                    android:layout_height="400dp"
                    android:background="@color/hollow"
                    android:paddingTop="5dp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/coverage_chart_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminate="true" />
        </android.support.v7.widget.CardView>

        <android.support.v7.widget.CardView
            android:id="@+id/chart_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:layout_marginStart="5dp"
            android:layout_marginTop="8dp"
            app:contentPadding="@dimen/card_inner_padding"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/distribution_chart_area"
            app:layout_constraintTop_toBottomOf="@+id/coverage_area">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/legend_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/border_below"
                    android:paddingBottom="5dp"
                    android:text="@string/chart_subtitle"
                    android:textAlignment="center"
                    android:textSize="@dimen/score_title_text_size"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/degree_overview_label" />

                <GridLayout
                    android:id="@+id/chart_legend_table"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingBottom="5dp"
                    android:paddingEnd="5dp"
                    android:paddingStart="5dp"
                    android:paddingTop="5dp">

                </GridLayout>
            </LinearLayout>

        </android.support.v7.widget.CardView>

        <android.support.v7.widget.CardView
            android:id="@+id/distribution_chart_area"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:layout_marginStart="5dp"
            android:layout_marginTop="8dp"
            app:contentPadding="@dimen/card_inner_padding"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/top_ka_chart_area"
            app:layout_constraintTop_toBottomOf="@+id/chart_subtitle">

            <android.support.constraint.ConstraintLayout
                android:id="@+id/ka_percentiles_chart_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/ka_percentile_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/border_below"
                    android:paddingBottom="5dp"
                    android:text="@string/ka_distribution"
                    android:textAlignment="center"
                    android:textSize="@dimen/score_title_text_size"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />


                <android.support.v4.view.ViewPager
                    android:id="@+id/ka_percentile_viewpager"
                    android:layout_width="0dp"
                    android:layout_height="500dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/ka_percentile_label">

                    <android.support.design.widget.TabLayout
                        android:id="@+id/ka_percentile_tabs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"></android.support.design.widget.TabLayout>
                </android.support.v4.view.ViewPager>

            </android.support.constraint.ConstraintLayout>

            <ProgressBar
                android:id="@+id/ka_percent_chart_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminate="true" />
        </android.support.v7.widget.CardView>

        <android.support.v7.widget.CardView
            android:id="@+id/top_ka_chart_area"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:layout_marginStart="5dp"
            android:layout_marginTop="8dp"
            app:contentPadding="@dimen/card_inner_padding"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/top_ka_topics_chart_area"
            app:layout_constraintTop_toBottomOf="@+id/distribution_chart_area">

            <android.support.constraint.ConstraintLayout
                android:id="@+id/top_ka_chart_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/top_ka_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/border_below"
                    android:paddingBottom="5dp"
                    android:text="@string/top_kas"
                    android:textAlignment="center"
                    android:textSize="@dimen/score_title_text_size"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />


                <android.support.v4.view.ViewPager
                    android:id="@+id/top_ka_viewpager"
                    android:layout_width="0dp"
                    android:layout_height="300dp"

                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/top_ka_label">

                    <android.support.design.widget.TabLayout
                        android:id="@+id/top_ka_tabs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"></android.support.design.widget.TabLayout>
                </android.support.v4.view.ViewPager>

            </android.support.constraint.ConstraintLayout>

            <ProgressBar
                android:id="@+id/top_kas_chart_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminate="true" />

        </android.support.v7.widget.CardView>

        <android.support.v7.widget.CardView
            android:id="@+id/top_ka_topics_chart_area"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:layout_marginEnd="5dp"
            android:layout_marginStart="5dp"
            android:layout_marginTop="8dp"
            app:contentPadding="@dimen/card_inner_padding"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/top_ka_chart_area">

            <android.support.constraint.ConstraintLayout
                android:id="@+id/top_ka_topics_chart_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/top_ka_topics_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/border_below"
                    android:paddingBottom="5dp"
                    android:text="@string/top_ka_topics"
                    android:textAlignment="center"
                    android:textSize="@dimen/score_title_text_size"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <android.support.v4.view.ViewPager
                    android:id="@+id/top_ka_topics_viewpager"
                    android:layout_width="0dp"
                    android:layout_height="500dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/top_ka_topics_label">

                    <android.support.design.widget.TabLayout
                        android:id="@+id/top_ka_topics_tabs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"></android.support.design.widget.TabLayout>
                </android.support.v4.view.ViewPager>

            </android.support.constraint.ConstraintLayout>

            <ProgressBar
                android:id="@+id/top_ka_topics_chart_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminate="true" />
        </android.support.v7.widget.CardView>


    </android.support.constraint.ConstraintLayout>
</ScrollView>